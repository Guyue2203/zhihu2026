# 复制为 .env.local 后填写真实值：cp .env.example .env.local
# 注意：node --env-file 不会覆盖 shell 里已存在的同名环境变量，
#      若本地曾 export 过 ZHIHU_ACCESS_SECRET 等变量，它会静默盖掉这里的值。

PORT=3000
# 监听地址。默认 127.0.0.1，由 nginx / Caddy 反代对外，应用不直接暴露。
# 只有确实要让应用自己监听公网时才改成 0.0.0.0（此时必须自行处理 TLS）。
# HOST=127.0.0.1
# 前后端分离部署时填前端源（例如 http://127.0.0.1:5173）以放开 CORS；留空表示仅同源，且不返回任何 CORS 头
# FRONTEND_ORIGIN=

ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE_URL=https://developer.zhihu.com
ZHIHU_SEARCH_COUNT=10
ZHIHU_TIMEOUT_MS=30000
JOURNEY_CACHE_TTL_MS=604800000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用；当前正式模型为 deepseek-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# V4 系列默认开启思考模式，会把 max_tokens 先花在 reasoning 上。
# 本项目 prelude 只有 400 个 token，实测开启思考会返回 finish_reason=length 且正文为空、JSON 必然解析失败，
# 所以默认关闭。换成自定义网关且该参数不被支持时，留空即可（留空时不发送该字段）。
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_MS=90000
# 默认 0：输出尽量确定，便于 JSON 校验；调高会让时间线更发散也更难复现
# DEEPSEEK_TEMPERATURE=0

# Timeline-first retrieval
CRAWLER_ENABLED=true
CRAWLER_TIMEOUT_MS=8000

# 知乎热搜（首页轮播）
ZHIHU_HOT_LIMIT=20
HOT_CACHE_TTL_MS=600000
# 热搜标题英译：仅在回源时调用一次 DeepSeek，与热搜一起进缓存；超时按失败处理
HOT_TRANSLATE_TIMEOUT_MS=20000

# 本地持久化（SQLite，内置 node:sqlite，无需安装任何依赖）
# 默认写入项目内 .data/zhihu.db；数据库含登录会话与 OAuth token，已被 .gitignore 忽略
# 这两个若填相对路径，按「启动时的当前工作目录」解析，不是按项目根目录；用 npm start 启动时二者相同
# ZHIHU_DATA_DIR=.data
# ZHIHU_DB_PATH=.data/zhihu.db
# 改造前 JSON 缓存的来源目录，只影响首次启动的自动导入；默认项目内 .cache/，一般无需修改
# JOURNEY_CACHE_DIR=.cache/journey
# HOT_CACHE_DIR=.cache/hot

# 知乎 OAuth 登录（黑客松）
# App ID 与 App Key 由赛事页面在创建项目后分配，与开放平台 Access Secret 不是同一套凭证
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 必须与知乎开放平台登记的 redirect_uri 完全一致（协议、域名、端口、路径、尾部斜杠、固定 Query 参数）
# 本地开发：http://127.0.0.1:3000/auth/callback（端口要和上面的 PORT 一致）
# 线上部署：https://flow.guyue.me/auth/callback（走 nginx 反代，这里不写内部端口 3003，写公网 443 的形态）
# 改这里的同时，必须去知乎开放平台同步修改登记值，否则回调对不上
ZHIHU_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# 仅用于 mock 测试或切换环境；正式联调保持默认
ZHIHU_OAUTH_BASE_URL=https://openapi.zhihu.com
ZHIHU_OAUTH_TIMEOUT_MS=30000
# OAuth state 有效期，默认 10 分钟
ZHIHU_OAUTH_STATE_TTL_MS=600000
# 浏览器标识 / 会话 Cookie 名，一般无需修改
CYBY_BROWSER_COOKIE=cyby_browser
CYBY_SESSION_COOKIE=cyby_session

# 用户数据接口（创作 / 关注）整页缓存有效期，默认 10 分钟
# 这组接口共用 user_data 额度（默认每日 100 次），翻页会稳定消耗，因此务必保留缓存
# 设为 0 可停用；调试时可用 ?refresh=1 单次绕过
USER_API_CACHE_TTL_MS=600000
